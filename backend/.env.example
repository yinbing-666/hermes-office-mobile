# 复制为 .env 并填入真实值，不要提交 .env
# 全部为占位示例；部署前必须设置 HERMES_AUTH_MODE=local 并配置口令

# Hermes 本地安装目录（BFF 数据来源）
HERMES_HOME=~/.hermes
HERMES_WIKI_HOME=
HERMES_VAULT_HOME=

# 认证：disabled（默认，无鉴权）或 local（口令 + 会话）
HERMES_AUTH_MODE=disabled
HERMES_ALLOWED_ORIGIN=https://office.example.com
HERMES_LOCAL_AUTH_CONFIG=
HERMES_SESSION_TTL_SECONDS=604800

# LLM 相关功能（OpenAI 兼容接口）
DRAGON_BASE_URL=
DRAGON_MODEL=
DRAGON_API_KEY=

# 可选：用量统计脚本路径
TOKEN_TRACKER_PYTHON=
TOKEN_TRACKER_SITE_PACKAGES=
